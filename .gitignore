# .gitignore

# Python
__pycache__/
*.py[oc]
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Логи
logs/
*.log
*.log.zip
*.log.gz
*.log.*

# Модели (большие файлы)
models/
*.pkl
*.h5
*.pt
*.pth
*.onnx
*.pb
*.tflite

# Данные (большие файлы)
data/
# Исключаем .gitkeep
!data/.gitkeep
!data/books/.gitkeep
data/books/*
!data/books/.gitkeep

# Книги (защищены авторским правом)
*.epub
*.fb2
*.pdf
*.doc
*.docx
*.txt

# Конфиги с секретами
.env
.env.local
.env.*.local
config/local.json
config/*.local.json

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Тесты
.pytest_cache/
.coverage
htmlcov/

# Системные
.DS_Store
Thumbs.db
desktop.ini