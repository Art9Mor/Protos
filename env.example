# Режим отладки
DEBUG=True

# Уровни логирования:
# 0 - NONE (все отключено)
# 1 - INFO
# 2 - SUCCESS
# 3 - WARNING
# 4 - ERROR
# 5 - DEBUG
# 6 - ALL (все уровни)
LOG_LEVELS=1,5

# Куда выводить логи: console, file, both
LOG_OUTPUT=both

# Куда выводить диалоги: console, file, both
DIALOG_OUTPUT=file

# Показывать логи в консоли
SHOW_LOGS_IN_CONSOLE=True

# Папка для логов
LOG_DIR=logs